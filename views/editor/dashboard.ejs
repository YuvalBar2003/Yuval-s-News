<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>מערכת עריכה - Yuval's News</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f6f9; margin: 0; padding: 20px; color: #333; }
    .header { display: flex; justify-content: space-between; align-items: center; background: white; padding: 15px 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 25px; }
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 25px; }
    .stat-card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-right: 5px solid #007bff; }
    .stat-number { font-size: 28px; font-weight: bold; color: #007bff; margin-top: 8px; }
    .section { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); margin-bottom: 25px; }
    .section h3 { margin-top: 0; border-bottom: 2px solid #eee; padding-bottom: 10px; }
    table { width: 100%; border-collapse: collapse; margin-top: 10px; }
    th, td { padding: 12px 15px; text-align: right; border-bottom: 1px solid #eee; }
    th { background: #f8f9fa; font-weight: bold; }
    .btn { padding: 6px 12px; border-radius: 4px; text-decoration: none; border: none; cursor: pointer; font-size: 13px; font-weight: bold; }
    .btn-approve { background: #28a745; color: white; }
    .btn-reject { background: #dc3545; color: white; }
    .feedback-input { padding: 6px; border: 1px solid #ccc; border-radius: 4px; width: 180px; font-size: 13px; }
    .legend-box { display: flex; gap: 20px; margin-top: 10px; font-size: 13px; }
    .legend-item { display: flex; align-items: center; gap: 6px; }
    .legend-color { width: 14px; height: 14px; border-radius: 3px; display: inline-block; }
    .impact-summary { display: none; margin-top: 15px; padding: 12px; background: #e8f4fd; border-radius: 6px; border-right: 4px solid #007bff; font-size: 14px; }
  </style>
</head>
<body>
  <div class="header">
    <h2>מערכת עריכה - שלום, <%= user.username %></h2>
    <div>
      <a href="/" class="btn" style="background:#007bff; color:white; margin-left:10px;">לאתר הראשי</a>
      <a href="/logout" class="btn" style="background:#6c757d; color:white;">התנתק</a>
    </div>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div>סך כל הצפיות באתר</div>
      <div class="stat-number">👁 <%= totalViews %></div>
    </div>
    <div class="stat-card" style="border-right-color: #ffc107;">
      <div>כתבות הממתינות לאישור</div>
      <div class="stat-number" style="color: #d39e00;"><%= pendingArticles.length %></div>
    </div>
    <div class="stat-card" style="border-right-color: #28a745;">
      <div>כתבות מפורסמות</div>
      <div class="stat-number" style="color: #28a745;"><%= publishedArticles.length %></div>
    </div>
  </div>

  <!-- גרף  Analytics -->
  <div class="section">
    <h3>Analytics - ניתוח צפיות כתבה</h3>
    <div style="margin-bottom: 15px;">
      <label><strong>בחר כתבה לצפייה בגרף:</strong> </label>
      <select id="analyticsSelect" style="padding: 6px 10px; border-radius: 4px;">
        <option value="">-- בחר כתבה --</option>
        <% publishedArticles.forEach(a => { %>
          <option value="<%= a._id %>"><%= a.title %></option>
        <% }) %>
      </select>
    </div>

    <div class="legend-box" id="chartLegend" style="display:none;">
      <div class="legend-item"><span class="legend-color" style="background:#007bff;"></span> צפיות לאורך ציר הזמן</div>
      <div class="legend-item"><span class="legend-color" style="background:#dc3545;"></span> נקודת אישור ופרסום עדכון עורך</div>
    </div>

    <div id="impactSummary" class="impact-summary"></div>

    <div style="max-height: 350px; margin-top: 15px;">
      <canvas id="viewsChart"></canvas>
    </div>
  </div>

  <div class="section">
    <h3>כתבות הממתינות לאישורך</h3>
    <% if (pendingArticles.length === 0) { %>
      <p style="color:#777;">אין כרגע כתבות הממתינות לאישור.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>כותרת</th>
            <th>כתב</th>
            <th>קטגוריה</th>
            <th>נשלחה בתאריך</th>
            <th>פעולות החלטה</th>
          </tr>
        </thead>
        <tbody>
          <% pendingArticles.forEach(article => { %>
            <tr>
              <td><strong><%= article.title %></strong></td>
              <td><%= article.authorName %></td>
              <td><%= article.category %></td>
              <td><%= new Date(article.updatedAt).toLocaleString('he-IL') %></td>
              <td>
                <form action="/editor/approve/<%= article._id %>" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-approve">אשר ופרסם ✔</button>
                </form>
                <form action="/editor/reject/<%= article._id %>" method="POST" style="display:inline; margin-right: 8px;">
                  <input type="text" name="feedback" placeholder="הערה לכתב..." class="feedback-input" required>
                  <button type="submit" class="btn btn-reject">החזר לתיקון ✖</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <script>
    let chartInstance = null;
    let activeUpdateHours = [];

    const updateLinePlugin = {
      id: 'updateLine',
      afterDatasetsDraw(chart) {
        if (!activeUpdateHours || !activeUpdateHours.length) return;
        const { ctx, chartArea: { top, bottom }, scales: { x } } = chart;

        activeUpdateHours.forEach(hour => {
          const targetLabel = `${hour}:00`;
          const targetIndex = chart.data.labels.indexOf(targetLabel);
          if (targetIndex !== -1) {
            const xPos = x.getPixelForValue(targetIndex);
            ctx.save();
            ctx.beginPath();
            ctx.strokeStyle = '#dc3545';
            ctx.lineWidth = 2;
            ctx.setLineDash([5, 5]);
            ctx.moveTo(xPos, top);
            ctx.lineTo(xPos, bottom);
            ctx.stroke();

            ctx.fillStyle = '#dc3545';
            ctx.font = 'bold 12px sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText(`עדכון`, xPos, top + 15);
            ctx.restore();
          }
        });
      }
    };

    document.getElementById('analyticsSelect').addEventListener('change', async (e) => {
      const id = e.target.value;
      const summaryDiv = document.getElementById('impactSummary');
      const legendDiv = document.getElementById('chartLegend');

      if (!id) {
        if (summaryDiv) summaryDiv.style.display = 'none';
        if (legendDiv) legendDiv.style.display = 'none';
        return;
      }

      try {
        const res = await fetch(`/api/analytics/${id}`);
        const data = await res.json();
        if (!data.success) return;

        const stats = data.stats || [];
        const labels = stats.map(s => `${s.hour}:00`);
        const views = stats.map(s => s.views);

        activeUpdateHours = (data.updateEvents || []).map(ev => new Date(ev.updatedAt).getHours());

        const pointColors = stats.map(s => activeUpdateHours.includes(s.hour) ? '#dc3545' : '#007bff');
        const pointRadii = stats.map(s => activeUpdateHours.includes(s.hour) ? 8 : 4);

        legendDiv.style.display = 'flex';

        //לפני ואחרי נקודת העדכון
        if (activeUpdateHours.length > 0) {
          const firstUpdate = Math.min(...activeUpdateHours);
          const preStats = stats.filter(s => s.hour < firstUpdate).map(s => s.views);
          const postStats = stats.filter(s => s.hour > firstUpdate).map(s => s.views);

          const preAvg = preStats.length ? Math.round(preStats.reduce((a, b) => a + b, 0) / preStats.length) : 0;
          const postAvg = postStats.length ? Math.round(postStats.reduce((a, b) => a + b, 0) / postStats.length) : 0;

          summaryDiv.style.display = 'block';
          summaryDiv.innerHTML = `<strong>📊 ניתוח השפעת עדכון עורך:</strong> ` +
            `ממוצע צפיות לפני העדכון: <strong>${preAvg} צפיות/שעה</strong> | ` +
            `ממוצע צפיות לאחר פרסום העדכון: <strong style="color:#28a745;">${postAvg} צפיות/שעה</strong> ` +
            `(${postAvg > preAvg ? 'עלייה בצפיות בעקבות העדכון' : 'התנהגות צפיות יציבה'})`;
        } else {
          summaryDiv.style.display = 'block';
          summaryDiv.innerHTML = `כתבה זו לא עברה עדכוני תוכן לאחר פרסומה הראשוני. הגרף מציג את התנהגות הצפיות השוטפת.`;
        }

        const ctx = document.getElementById('viewsChart').getContext('2d');
        if (chartInstance) chartInstance.destroy();

        chartInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels.length ? labels : ['אין נתונים'],
            datasets: [{
              label: 'כמות צפיות לאורך ציר הזמן',
              data: views.length ? views : [0],
              borderColor: '#007bff',
              backgroundColor: 'rgba(0,123,255,0.08)',
              pointBackgroundColor: pointColors,
              pointBorderColor: pointColors,
              pointRadius: pointRadii,
              fill: true,
              tension: 0.35
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              tooltip: {
                callbacks: {
                  label: function(context) {
                    const hour = parseInt(context.label);
                    if (activeUpdateHours.includes(hour)) {
                      return `צפיות: ${context.raw} (נקודת אישור ופרסום עדכון עורך)`;
                    }
                    return `צפיות: ${context.raw}`;
                  }
                }
              }
            },
            scales: {
              x: { title: { display: true, text: 'שעות היממה (ציר זמן)' } },
              y: { beginAtZero: true, title: { display: true, text: 'כמות צפיות' } }
            }
          },
          plugins: [updateLinePlugin]
        });
      } catch (err) {
        console.error('שגיאה בטעינת הגרף:', err);
      }
    });
  </script>
</body>
</html>