<!DOCTYPE html>
<html lang="he" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Yuval's News - פורטל חדשות</title>
  <style>
    * { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f0f2f5; margin: 0; color: #222; }
    .navbar { background: #1c2331; color: white; padding: 15px 30px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
    .navbar a { color: white; text-decoration: none; font-weight: bold; }
    .brand { font-size: 24px; letter-spacing: 1px; }
    .nav-btn { background: #007bff; color: white; padding: 8px 14px; border-radius: 4px; font-size: 13px; margin-right: 8px; border: none; cursor: pointer; text-decoration: none; display: inline-block; }
    
    .toolbar { background: white; border-bottom: 1px solid #ddd; padding: 15px 30px; display: flex; flex-wrap: wrap; gap: 15px; align-items: center; justify-content: space-between; }
    .filter-group { display: flex; gap: 10px; flex-wrap: wrap; }
    .toolbar select, .toolbar input { padding: 8px 12px; border: 1px solid #ccc; border-radius: 4px; font-size: 14px; }
    
    .main-layout { max-width: 1300px; margin: 25px auto; padding: 0 20px; display: flex; flex-direction: row; gap: 25px; align-items: flex-start; }
    .feed { flex: 1; }
    .sidebar { width: 280px; flex-shrink: 0; position: sticky; top: 85px; }

    .weather-widget { background: white; border-radius: 8px; padding: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.06); text-align: center; border-top: 4px solid #17a2b8; }
    .weather-temp { font-size: 38px; font-weight: bold; margin: 10px 0; color: #17a2b8; }
    
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .card { background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.06); display: flex; flex-direction: column; transition: transform 0.2s; }
    .card:hover { transform: translateY(-3px); }
    .card img { width: 100%; height: 180px; object-fit: cover; }
    .card-content { padding: 18px; flex: 1; display: flex; flex-direction: column; }
    .badge-cat { font-size: 12px; font-weight: bold; color: #007bff; margin-bottom: 6px; }
    .card-title { font-size: 18px; margin: 0 0 8px 0; line-height: 1.4; }
    .card-title a { color: #111; text-decoration: none; }
    .card-summary { font-size: 14px; color: #666; margin-bottom: 15px; flex: 1; line-height: 1.5; }
    .card-meta { font-size: 12px; color: #888; border-top: 1px solid #eee; padding-top: 10px; display: flex; justify-content: space-between; }
    
    #loadingIndicator { text-align: center; padding: 25px; font-size: 15px; color: #666; display: none; }
    
    @media (max-width: 650px) { 
      .main-layout { flex-direction: column; } 
      .sidebar { width: 100%; position: static; } 
    }
  </style>
</head>
<body>

  <header class="navbar">
    <div class="brand"><a href="/">Yuval's News</a></div>
    <div>
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <span>שלום, <strong><%= currentUser.username %></strong></span>
        
        <% if (currentUser.role === 'editor') { %>
          <a href="/editor" class="nav-btn" style="background:#28a745;">מערכת עריכה</a>
        <% } else { %>
          <a href="/reporter" class="nav-btn" style="background:#17a2b8;">אזור כתב</a>
        <% } %>

        <button onclick="changePasswordPrompt()" class="nav-btn" style="background:#495057;">עדכון סיסמה</button>
        <button onclick="deleteMyAccount()" class="nav-btn" style="background:#dc3545;">מחק חשבון</button>

        <a href="/logout" class="nav-btn" style="background:#6c757d;">התנתק</a>
      <% } else { %>
        <a href="/login" class="nav-btn">כניסת מערכת</a>
      <% } %>
    </div>
  </header>

  <nav class="toolbar">
    <div class="filter-group">
      <input type="text" id="searchInput" placeholder="חיפוש בכותרות...">
      <select id="categoryFilter">
        <option value="all">כל הקטגוריות</option>
        <option value="חדשות">חדשות</option>
        <option value="ספורט">ספורט</option>
        <option value="כלכלה">כלכלה</option>
        <option value="טכנולוגיה">טכנולוגיה</option>
        <option value="תרבות">תרבות</option>
      </select>
      <select id="sortFilter">
        <option value="newest">הכי חדש</option>
        <option value="popular">הכי פופולרי</option>
        <option value="oldest">הכי ישן</option>
      </select>
    </div>
  </nav>

  <div class="main-layout">
    <aside class="sidebar">
      <div class="weather-widget">
        <h3>מזג אוויר מקומי</h3>
        <p style="margin:0; color:#666;"><%= weather.city %></p>
        <div class="weather-temp"><%= weather.temp %>°C</div>
        <p style="margin:0; font-size:13px; color:#888;">רוח: <%= weather.windspeed %> קמ"ש</p>
      </div>
    </aside>

    <main class="feed">
      <div class="grid" id="articlesGrid">
        <% articles.forEach(article => { %>
          <article class="card">
            <img src="<%= article.imageUrl %>" alt="<%= article.title %>">
            <div class="card-content">
              <span class="badge-cat"><%= article.category %></span>
              <h2 class="card-title">
                <a href="/article/<%= article._id %>"><%= article.title %></a>
              </h2>
              <p class="card-summary"><%= article.summary %></p>
              <div class="card-meta">
                <span>מאת: <%= article.authorName %></span>
                <span><%= new Date(article.publishedAt).toLocaleDateString('he-IL') %></span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
      <div id="loadingIndicator">טוען כתבות נוספות...</div>
    </main>
  </div>

  <script>
    async function changePasswordPrompt() {
      const newPassword = prompt('הכנס סיסמה חדשה:');
      if (!newPassword || newPassword.trim() === '') return;

      try {
        const res = await fetch('/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ newPassword: newPassword.trim() })
        });
        const data = await res.json();
        if (data.success) {
          alert('הסיסמה עודכנה בהצלחה!');
        } else {
          alert(data.message || 'שגיאה בעדכון הסיסמה');
        }
      } catch (err) {
        alert('שגיאת תקשורת עם השרת');
      }
    }

    async function deleteMyAccount() {
      if (!confirm('האם אתה בטוח שברצונך למחוק את החשבון שלך לצמיתות?')) return;

      try {
        const res = await fetch('/profile/delete', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          alert('החשבון נמחק בהצלחה.');
          window.location.href = '/login';
        } else {
          alert(data.message || 'שגיאה במחיקת החשבון');
        }
      } catch (err) {
        alert('שגיאת תקשורת עם השרת');
      }
    }

    let currentPage = 1;
    let isLoading = false;
    let hasMore = true;

    async function loadArticles(reset = false) {
      if (isLoading || (!hasMore && !reset)) return;
      isLoading = true;
      document.getElementById('loadingIndicator').style.display = 'block';

      if (reset) {
        currentPage = 1;
        hasMore = true;
        document.getElementById('articlesGrid').innerHTML = '';
      }

      const search = document.getElementById('searchInput').value;
      const category = document.getElementById('categoryFilter').value;
      const sort = document.getElementById('sortFilter').value;

      try {
        const res = await fetch(`/api/articles?page=${currentPage}&search=${encodeURIComponent(search)}&category=${category}&sort=${sort}`);
        const data = await res.json();

        if (data.success && data.articles.length > 0) {
          data.articles.forEach(article => {
            const card = document.createElement('article');
            card.className = 'card';
            card.innerHTML = `
              <img src="${article.imageUrl}" alt="${article.title}">
              <div class="card-content">
                <span class="badge-cat">${article.category}</span>
                <h2 class="card-title">
                  <a href="/article/${article._id}">${article.title}</a>
                </h2>
                <p class="card-summary">${article.summary || ''}</p>
                <div class="card-meta">
                  <span>מאת: ${article.authorName}</span>
                  <span>${new Date(article.publishedAt).toLocaleDateString('he-IL')}</span>
                </div>
              </div>
            `;
            document.getElementById('articlesGrid').appendChild(card);
          });
          currentPage++;
        } else {
          hasMore = false;
        }
      } catch (err) {
        console.error(err);
      } finally {
        isLoading = false;
        document.getElementById('loadingIndicator').style.display = 'none';
      }
    }

    document.getElementById('categoryFilter').addEventListener('change', () => loadArticles(true));
    document.getElementById('sortFilter').addEventListener('change', () => loadArticles(true));
    let searchDebounce;
    document.getElementById('searchInput').addEventListener('input', () => {
      clearTimeout(searchDebounce);
      searchDebounce = setTimeout(() => loadArticles(true), 400);
    });

    window.addEventListener('scroll', () => {
      if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 500) {
        loadArticles();
      }
    });
  </script>
</body>
</html>